art/current/pulso_disaster_world_current.blend filter=lfs diff=lfs merge=lfs -text
art/current/ragdoll/canonical/*.blend filter=lfs diff=lfs merge=lfs -text
art/current/ragdoll/navigable/pulso_ragdoll_navigable.blend filter=lfs diff=lfs merge=lfs -text

