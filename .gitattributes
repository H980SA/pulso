# Canonical runtime meshes are large but required by a fresh simulation clone.
sim/ros2_ws/src/pulso_gazebo/models/pulso_disaster_scene/meshes/*.dae filter=lfs diff=lfs merge=lfs -text
sim/ros2_ws/src/pulso_gazebo/models/pulso_disaster_scene/meshes/*.glb filter=lfs diff=lfs merge=lfs -text

# Only accepted Blender sources use LFS; checkpoints, exports and legacy seeds
