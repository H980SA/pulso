<?xml version="1.0"?>
<package format="3">
  <name>pulso_sim_adapter</name>
  <version>0.1.0</version>
  <description>Normalize Gazebo samples into Pulso's hardware-parity sensor topics.</description>
  <maintainer email="pulso@example.invalid">Pulso Team</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- onnxruntime-gpu lives in the isolated PULSO perception venv. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
