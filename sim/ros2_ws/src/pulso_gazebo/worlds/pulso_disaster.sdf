<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pulso_disaster">
    <!-- 400 Hz remains far above every physical / sensing actuator rate in
         this slow rover (0.3 mm nominal travel per step), while profiling the
         complete world showed that 1 kHz serialized physics held the demo to
         ~0.46x real time. 2.5 ms recovered ~0.97x without reducing any camera,
         depth, IMU, sonar, SLAM, collision, or map update rate. -->
    <physics name="step_2_5ms" type="ignored">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo-contact-system.so"
            name="ignition::gazebo::systems::Contact"/>

    <scene>
      <ambient>0.025 0.03 0.04 1</ambient>
      <background>0.005 0.008 0.012 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <!-- A deterministic operator view prevents Gazebo from opening on empty
         space or a black unlit angle. Sensor cameras still use their own
         calibrated phone poses; this camera is only for the human demo. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="Pulso Disaster View">
        <ignition-gui>
          <title>Pulso Disaster View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <!-- Operator-only inspection light. The phone sensors continue to use
             the much darker world scene and must still actuate the torch. -->
        <ambient_light>0.48 0.52 0.60</ambient_light>
        <background_color>0.005 0.008 0.012</background_color>
        <camera_pose>2 -11 8 0 0.63 1.5708</camera_pose>
        <camera_clip><near>0.03</near><far>120</far></camera_clip>
      </plugin>
      <!-- Fortress splits the GUI renderer in two: MinimalScene owns the
           camera / render surface, while GzSceneManager mirrors the server's
           entities into that scene. Omitting this plugin leaves a valid but
           empty black viewport even though sensor cameras keep rendering. -->
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <property type="string" key="state">floating</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera tracking">
        <ignition-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="Pulso Disaster View">
            <line own="left" target="left"/><line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="Pulso Disaster View">
            <line own="right" target="right"/><line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time><real_time>true</real_time>
        <real_time_factor>true</real_time_factor><iterations>true</iterations>
      </plugin>
    </gui>

    <light type="directional" name="dusty_moonlight">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.12 0.17 0.22 1</diffuse>
      <specular>0.03 0.04 0.05 1</specular>
      <direction>-0.35 0.2 -0.92</direction>
    </light>

    <include>
      <uri>model://pulso_disaster_scene</uri>
      <name>pulso_disaster_scene</name>
    </include>

    <!-- Collision-only companions for survivor and collapse visuals already
         baked into pulso_disaster_scene. Their poses use world XYZ. -->
    <include>
      <uri>model://pulso_settled_occupants</uri>
      <name>pulso_settled_occupants</name>
    </include>

    <include>
      <uri>model://pulso_dynamic_debris</uri>
      <name>pulso_dynamic_debris</name>
    </include>

    <model name="pulso_openbot">
      <!-- Start one metre before the first constriction.  The former 3.06 m
           pose placed the phone optics 17 cm from a rounded debris face,
           obscuring the initial RGB frame and starving exploration of useful
           parallax.  This pose keeps the same corridor and heading while
           exposing real depth, VIO and frontier evidence immediately. -->
      <pose>4.0 -0.52 0.085 0 0 3.14159</pose>
      <link name="base_link">
        <inertial>
          <mass>1.55</mass>
          <inertia><ixx>0.0048</ixx><iyy>0.0092</iyy><izz>0.0122</izz></inertia>
        </inertial>
        <!-- The OpenBot CAD is visual-only. This compound envelope follows
             its measured bounds without filling wheel wells with a dynamic
             triangle mesh or creating an invisible 40 mm roof. -->
        <collision name="base_collision">
          <pose>-0.0045 0.001 0.0025 0 0 0</pose>
          <geometry><box><size>0.249 0.152 0.0355</size></box></geometry>
        </collision>
        <collision name="phone_mount_left_collision">
          <pose>0.055 0.05 0.068 0 0 0</pose>
          <geometry><box><size>0.012 0.012 0.096</size></box></geometry>
        </collision>
        <collision name="phone_mount_right_collision">
          <pose>0.055 -0.05 0.068 0 0 0</pose>
          <geometry><box><size>0.012 0.012 0.096</size></box></geometry>
        </collision>
        <collision name="bumper_collision">
          <pose>0.1425 0 0.035 0 0 0</pose>
          <geometry><box><size>0.015 0.16 0.05</size></box></geometry>
        </collision>
        <visual name="openbot_body_bottom_visual">
          <pose>-0.014 -0.008 -0.01525 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://pulso_openbot/meshes/body_bottom_visual_lod25.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material><ambient>0.025 0.08 0.16 1</ambient><diffuse>0.04 0.19 0.38 1</diffuse><specular>0.15 0.2 0.3 1</specular></material>
        </visual>
        <visual name="openbot_body_top_visual">
          <pose>-0.014 -0.008 0.01425 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://pulso_openbot/meshes/body_top_visual_lod25.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material><ambient>0.035 0.11 0.22 1</ambient><diffuse>0.055 0.26 0.52 1</diffuse><specular>0.18 0.24 0.34 1</specular></material>
        </visual>
        <!-- Honest proxy brackets: they connect the measured S25 pose to the
             chassis without claiming that the official clamp is calibrated. -->
        <visual name="phone_mount_left_visual">
          <pose>0.055 0.05 0.068 0 0 0</pose>
          <geometry><box><size>0.012 0.012 0.096</size></box></geometry>
          <material><ambient>0.03 0.035 0.045 1</ambient><diffuse>0.08 0.09 0.12 1</diffuse></material>
        </visual>
        <visual name="phone_mount_right_visual">
          <pose>0.055 -0.05 0.068 0 0 0</pose>
          <geometry><box><size>0.012 0.012 0.096</size></box></geometry>
          <material><ambient>0.03 0.035 0.045 1</ambient><diffuse>0.08 0.09 0.12 1</diffuse></material>
        </visual>
        <sensor name="front_sonar_cone" type="gpu_lidar">
          <pose>0.14 0 0.045 0 0 0</pose>
          <topic>/pulso/sim/base/front_scan</topic>
          <update_rate>20</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>7</samples>
                <resolution>1</resolution>
                <min_angle>-0.14</min_angle>
                <max_angle>0.14</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.035</min>
              <max>4.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.006</stddev></noise>
          </lidar>
          <always_on>true</always_on>
        </sensor>
        <sensor name="front_bumper_contact" type="contact">
          <topic>/pulso/sim/base/bumper_contacts</topic>
          <update_rate>50</update_rate>
          <contact><collision>bumper_collision</collision></contact>
          <always_on>true</always_on>
        </sensor>
      </link>

      <link name="phone_sensor_link">
        <pose relative_to="base_link">0.055 0 0.155 0 0 0</pose>
        <!-- S25 Ultra + light case, mounted upright in landscape orientation. -->
        <inertial><mass>0.232</mass><inertia><ixx>0.000628</ixx><iyy>0.000117</iyy><izz>0.000514</izz></inertia></inertial>
        <collision name="phone_collision">
          <geometry><box><size>0.0082 0.1628 0.0776</size></box></geometry>
        </collision>
        <visual name="phone_visual">
          <geometry><box><size>0.0082 0.1628 0.0776</size></box></geometry>
          <material><ambient>0.04 0.05 0.07 1</ambient><diffuse>0.055 0.065 0.09 1</diffuse></material>
        </visual>
        <light name="phone_flashlight" type="spot">
          <pose>0.006 -0.054 0.023 0 0 0</pose>
          <!-- Fortress self-shadows a link-mounted light against its own phone body. -->
          <cast_shadows>false</cast_shadows>
          <visualize>false</visualize>
          <light_on>false</light_on>
          <intensity>0.5</intensity>
          <diffuse>1.0 0.91 0.72 1</diffuse>
          <specular>0.18 0.16 0.12 1</specular>
          <attenuation>
            <range>8.0</range>
            <constant>0.25</constant>
            <linear>0.02</linear>
            <quadratic>0.002</quadratic>
          </attenuation>
          <direction>1 0 0</direction>
          <spot><inner_angle>0.28</inner_angle><outer_angle>0.95</outer_angle><falloff>0.65</falloff></spot>
        </light>
        <sensor name="phone_rgb" type="camera">
          <pose>0.006 -0.054 0.023 0 0 0</pose>
          <topic>/pulso/sim/phone/rgb</topic>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.256637</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.08</near><far>12.0</far></clip>
          </camera>
          <always_on>true</always_on>
          <!-- Sensor debug frusta must never leak into the robot's RGB feed. -->
          <visualize>false</visualize>
        </sensor>
        <sensor name="phone_depth" type="depth_camera">
          <pose>0.006 -0.054 0.023 0 0 0</pose>
          <topic>/pulso/sim/phone/depth_clean</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.256637</horizontal_fov>
            <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
            <clip><near>0.08</near><far>12.0</far></clip>
          </camera>
          <always_on>true</always_on>
        </sensor>
        <sensor name="phone_imu" type="imu">
          <topic>/pulso/sim/phone/imu</topic>
          <update_rate>100</update_rate>
          <always_on>true</always_on>
        </sensor>
      </link>
      <joint name="phone_mount_joint" type="fixed">
        <parent>base_link</parent><child>phone_sensor_link</child>
      </joint>

      <link name="front_left_wheel"><pose relative_to="base_link">0.105 0.092 0 1.570796 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry><surface><friction><ode><mu>0.28</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry></visual></link>
      <link name="rear_left_wheel"><pose relative_to="base_link">-0.105 0.092 0 1.570796 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry><surface><friction><ode><mu>0.28</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry></visual></link>
      <link name="front_right_wheel"><pose relative_to="base_link">0.105 -0.092 0 1.570796 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry><surface><friction><ode><mu>0.28</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry></visual></link>
      <link name="rear_right_wheel"><pose relative_to="base_link">-0.105 -0.092 0 1.570796 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry><surface><friction><ode><mu>0.28</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry></visual></link>

      <!-- SDF expresses an unqualified axis in the joint frame, which is
           attached to the child wheel. These wheel links are rolled 90 deg
           to orient their cylinders, so an implicit `0 1 0` became a vertical
           swivel axis. Pinning the axle to the model frame makes commanded
           encoder motion and physical wheel rotation share robot +Y. -->
      <joint name="front_left_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="rear_left_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="front_right_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="rear_right_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>

      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>front_left_joint</left_joint><left_joint>rear_left_joint</left_joint>
        <right_joint>front_right_joint</right_joint><right_joint>rear_right_joint</right_joint>
        <wheel_separation>0.184</wheel_separation><wheel_radius>0.033</wheel_radius>
        <topic>/pulso/base/cmd_vel_safe</topic>
        <!-- DiffDrive integrates wheel motion; it is encoder odometry, not
             physical ground truth when the rover slips or is blocked. -->
        <odom_topic>/pulso/sim/wheel_encoder/odom</odom_topic>
        <tf_topic>/pulso/sim/wheel_encoder/tf</tf_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>

      <!-- Private simulator truth.  The VIO emulator converts this absolute
           world pose into an ARCore-like session-local pose before exposing
           it to navigation. -->
      <plugin filename="libignition-gazebo-odometry-publisher-system.so"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>2</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/pulso/sim/ground_truth/odom</odom_topic>
        <odom_covariance_topic>/pulso/sim/ground_truth/odom_with_covariance</odom_covariance_topic>
        <tf_topic>/pulso/sim/ground_truth/tf</tf_topic>
      </plugin>
    </model>
  </world>
</sdf>
