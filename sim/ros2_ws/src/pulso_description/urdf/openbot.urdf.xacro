<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pulso_openbot">
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_x" value="0.105"/>
  <xacro:property name="wheel_y" value="0.092"/>

  <material name="pulso_black"><color rgba="0.025 0.03 0.04 1"/></material>
  <material name="pulso_orange"><color rgba="1.0 0.28 0.03 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.055"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><box size="0.26 0.17 0.07"/></geometry>
      <material name="pulso_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry><box size="0.26 0.17 0.07"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="1.55"/>
      <inertia ixx="0.0048" ixy="0" ixz="0" iyy="0.0092" iyz="0" izz="0.0122"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin rpy="1.570796 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="pulso_black"/>
      </visual>
      <collision>
        <origin rpy="1.570796 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00008"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}"/>
      <origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel" x="${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rear_left_wheel" x="-${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="front_right_wheel" x="${wheel_x}" y="-${wheel_y}"/>
  <xacro:wheel name="rear_right_wheel" x="-${wheel_x}" y="-${wheel_y}"/>

  <link name="phone_mount"/>
  <joint name="base_to_phone_mount" type="fixed">
    <parent link="base_link"/><child link="phone_mount"/>
    <origin xyz="0.055 0 0.155" rpy="0 0 0"/>
  </joint>

  <link name="phone_imu_link"/>
  <joint name="phone_mount_to_imu" type="fixed">
    <parent link="phone_mount"/><child link="phone_imu_link"/>
  </joint>

  <link name="phone_camera_link"/>
  <joint name="phone_mount_to_camera" type="fixed">
    <parent link="phone_mount"/><child link="phone_camera_link"/>
    <!-- Rear camera position on an upright, landscape-mounted S25 Ultra. -->
    <origin xyz="0.006 -0.054 0.023"/>
  </joint>

  <link name="phone_camera_optical_frame"/>
  <joint name="camera_to_optical" type="fixed">
    <parent link="phone_camera_link"/><child link="phone_camera_optical_frame"/>
    <origin rpy="-1.570796 0 -1.570796"/>
  </joint>

  <link name="sonar_front_link"/>
  <joint name="base_to_sonar" type="fixed">
    <parent link="base_link"/><child link="sonar_front_link"/>
    <origin xyz="0.135 0 0.055"/>
  </joint>

  <link name="bumper_link"/>
  <joint name="base_to_bumper" type="fixed">
    <parent link="base_link"/><child link="bumper_link"/>
    <origin xyz="0.145 0 0.035"/>
  </joint>
</robot>
