{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulso.local/contracts/pulso-perception-telemetry-v1.schema.json",
  "title": "PULSO perception telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "published_monotonic_ns",
    "source_capture_ns",
    "model_id",
    "status",
    "detection_count",
    "inference_latency_ms",
    "semantic_revision"
  ],
  "properties": {
    "contract_version": { "const": "pulso.perception-telemetry.v1" },
    "published_monotonic_ns": { "type": "integer", "minimum": 0 },
    "source_capture_ns": { "type": "integer", "minimum": 0 },
    "model_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 96 },
    "status": { "enum": ["WARMING", "LIVE", "ERROR"] },
    "detection_count": { "type": "integer", "minimum": 0 },
    "inference_latency_ms": { "type": "integer", "minimum": 0 },
    "semantic_revision": { "type": "integer", "minimum": 0 }
  }
}
