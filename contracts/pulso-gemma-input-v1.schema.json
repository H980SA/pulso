{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulso.local/contracts/pulso-gemma-input-v1.schema.json",
  "title": "PULSO exact Gemma call input evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input_id",
    "published_monotonic_ns",
    "turn_id",
    "selected_world_seq",
    "model_id",
    "input_kind",
    "exact_message",
    "prompt_text",
    "image",
    "system_prompt",
    "system_prompt_sha256",
    "tool_schemas",
    "tool_schemas_sha256",
    "conversation_scope",
    "conversation_reused_within_turn",
    "conversation_reused_across_turns"
  ],
  "properties": {
    "contract_version": { "const": "pulso.gemma-input.v1" },
    "input_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "published_monotonic_ns": { "type": "integer", "minimum": 0 },
    "turn_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "selected_world_seq": { "type": "integer", "minimum": 0 },
    "model_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "input_kind": { "enum": ["WORLD_PACKET", "TOOL_RESULT"] },
    "exact_message": {
      "type": "object",
      "description": "Exact text/tool payload and content order. Image bytes are replaced only by their audit topic and are byte-exact on /pulso/hil/gemma_view/compressed."
    },
    "prompt_text": { "type": ["string", "null"] },
    "image": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "kind",
        "source_topic",
        "captured_monotonic_ns",
        "format",
        "jpeg_sha256",
        "byte_length",
        "audit_topic"
      ],
      "properties": {
        "kind": { "enum": ["META_VIEW", "EGO_RGB"] },
        "source_topic": { "type": "string" },
        "captured_monotonic_ns": { "type": "integer", "minimum": 0 },
        "format": { "type": "string" },
        "jpeg_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "audit_topic": { "const": "/pulso/hil/gemma_view/compressed" }
      }
    },
    "system_prompt": { "type": "string", "minLength": 1 },
    "system_prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tool_schemas": { "type": "array", "minItems": 1 },
    "tool_schemas_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conversation_scope": { "const": "TURN" },
    "conversation_reused_within_turn": { "const": true },
    "conversation_reused_across_turns": { "const": false },
    "context_tokens_before": { "type": "integer", "minimum": 0 }
  }
}
