{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulso.local/contracts/pulso-observation-v1.schema.json",
  "title": "Pulso observation envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "observation_id",
    "source",
    "captured_monotonic_ns",
    "frame_id",
    "tracking",
    "robot"
  ],
  "properties": {
    "contract_version": { "const": "pulso.observation.v1" },
    "observation_id": { "type": "string", "minLength": 1 },
    "source": { "enum": ["ANDROID_REAL", "GAZEBO_HIL", "REPLAY"] },
    "captured_monotonic_ns": { "type": "integer", "minimum": 0 },
    "frame_id": { "type": "string", "minLength": 1 },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "epoch", "quality"],
      "properties": {
        "state": { "enum": ["TRACKING", "LIMITED", "LOST"] },
        "epoch": { "type": "integer", "minimum": 0 },
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "cause": { "type": ["string", "null"] }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pose", "motion_state", "battery_fraction", "flashlight_on"],
      "properties": {
        "pose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position_m", "heading_deg", "confidence"],
          "properties": {
            "position_m": {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "heading_deg": { "type": "number" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "motion_state": { "enum": ["STOPPED", "MOVING", "BLOCKED", "FAULT"] },
        "battery_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "flashlight_on": { "type": "boolean" },
        "front_range_m": { "type": ["number", "null"], "minimum": 0 },
        "bumper_pressed": { "type": ["boolean", "null"] }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "captured_monotonic_ns", "uri"],
        "properties": {
          "artifact_id": { "type": "string" },
          "kind": {
            "enum": [
              "EGO_RGB",
              "RAW_DEPTH",
              "DEPTH_CONFIDENCE",
              "DENSE_POINT_CLOUD",
              "SPARSE_FEATURE_CLOUD",
              "AUDIO_WINDOW"
            ]
          },
          "captured_monotonic_ns": { "type": "integer", "minimum": 0 },
          "uri": { "type": "string" },
          "valid_for_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
